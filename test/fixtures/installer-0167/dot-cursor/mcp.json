{
  "mcpServers": {
    "owner-server": {
      "command": "owner-mcp",
      "args": [
        "--stdio"
      ]
    },
    "marrow": {
      "command": "npx",
      "args": [
        "-y",
        "--package=@getmarrow/mcp@3.9.98",
        "marrow-mcp"
      ],
      "env": {
        "MARROW_BASE_URL": "https://api.getmarrow.ai"
      }
    }
  }
}
